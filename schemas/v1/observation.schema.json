{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironkeeper.invalid/schemas/v1/observation.schema.json",
  "title": "Ironkeeper device observation",
  "description": "The observations collected from one explicitly selected device. An observation is not an assessment: this document never carries an admission verdict and never reports PASS. A field that the device did not provide is represented by an observation whose status is unavailable or unsupported, never by a zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this observation contract. Only version 1 is implemented.",
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "description": "RFC 3339 timestamp of the collection.",
      "type": "string",
      "minLength": 20,
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "device": {
      "description": "The device the observations belong to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_name",
        "device_class",
        "transport",
        "identity"
      ],
      "properties": {
        "kernel_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "device_class": {
          "type": "string",
          "enum": [
            "physical",
            "partition",
            "device_mapper",
            "raid",
            "loop",
            "ram",
            "optical",
            "virtual",
            "unknown"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "sas",
            "sata",
            "nvme",
            "scsi",
            "unknown"
          ]
        },
        "major": {
          "type": "string",
          "maxLength": 16
        },
        "minor": {
          "type": "string",
          "maxLength": 16
        },
        "vendor": {
          "type": "string",
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "serial": {
          "type": "string",
          "maxLength": 256
        },
        "firmware": {
          "type": "string",
          "maxLength": 256
        },
        "wwn": {
          "type": "string",
          "maxLength": 256
        },
        "capacity_bytes": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "logical_block_size": {
          "type": "integer",
          "minimum": 0
        },
        "physical_block_size": {
          "type": "integer",
          "minimum": 0
        },
        "paths": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "aliases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confidence",
            "identifiers"
          ],
          "properties": {
            "confidence": {
              "type": "string",
              "enum": [
                "authoritative",
                "probable",
                "ambiguous",
                "unresolved"
              ]
            },
            "identifiers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "namespace",
                  "value",
                  "original",
                  "source"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "scsi_wwn",
                      "ata_wwn",
                      "nguid",
                      "eui64",
                      "nvme_uuid",
                      "serial",
                      "disk_sequence_number"
                    ]
                  },
                  "namespace": {
                    "type": "string",
                    "enum": [
                      "logical_unit",
                      "namespace",
                      "controller"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "original": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            },
            "conflicts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "duplicate_serial": {
              "type": "boolean"
            }
          }
        },
        "sysfs_path": {
          "type": "string",
          "maxLength": 4096
        },
        "findings": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "rotational": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "description": "The normalised observations.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "source",
          "collected_at"
        ],
        "properties": {
          "name": {
            "description": "The stable name of the observed quantity.",
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "description": "How the observation was obtained.",
            "type": "string",
            "enum": [
              "observed",
              "derived",
              "unavailable",
              "unsupported",
              "invalid",
              "conflicting"
            ]
          },
          "value": {
            "description": "The exact value, as a canonical decimal string or a documented token. Absent when the observation carries no value.",
            "type": "string",
            "maxLength": 4096
          },
          "unit": {
            "description": "The unit of the value.",
            "type": "string",
            "maxLength": 64
          },
          "source": {
            "description": "The backend that produced the observation.",
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_field": {
            "description": "The field or derivation the value came from.",
            "type": "string",
            "maxLength": 512
          },
          "collected_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "reason": {
            "description": "Why the value is unavailable, unsupported, invalid or conflicting.",
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "executions": {
      "description": "The outcome of each external tool invocation.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "outcome",
          "exit_status"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "non_zero_exit",
              "timed_out",
              "launch_failed",
              "output_limit_exceeded",
              "signalled"
            ]
          },
          "exit_status": {
            "type": "integer"
          },
          "signal": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "attribution": {
      "description": "Whether the observations are bound to the selected device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "The attribution status of the collected observations.",
          "type": "string",
          "enum": [
            "bound",
            "refused"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "completeness": {
      "description": "The authoritative completeness of the collection. The completeness is derived from the requested observation coverage, not from the presence of an execution record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "Whether every requested observation was collected.",
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "findings": {
      "description": "The findings of the collection.",
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    }
  }
}
