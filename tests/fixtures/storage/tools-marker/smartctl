#!/bin/sh
# A `smartctl` that records that it was executed.
#
# The marker is written **next to the executable**, because the execution
# boundary hands the child a controlled environment: the marker cannot
# rely on an environment variable to learn where to write. The witness
# therefore copies this directory into a temporary directory and watches
# that copy.
echo "executed $*" >> "$(dirname "$0")/executed.marker"
exit 0
